{
    "name": "mfonte/redisw",
    "description": "An expressive, strictly-typed Redis client built on top of the phpredis PECL extension, with first-class caching helpers.",
    "keywords": [
        "php",
        "redis",
        "phpredis",
        "cache",
        "client",
        "wrapper",
        "psr-16",
        "simple-cache"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/mauriziofonte/php-redisw",
    "authors": [
        {
            "name": "Maurizio Fonte",
            "email": "fonte.maurizio@gmail.com",
            "homepage": "https://github.com/mauriziofonte",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/mauriziofonte/php-redisw/issues",
        "source": "https://github.com/mauriziofonte/php-redisw",
        "security": "https://github.com/mauriziofonte/php-redisw/security/policy"
    },
    "require": {
        "php": "^8.1",
        "ext-redis": ">=5.3",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "provide": {
        "psr/simple-cache-implementation": "2.0 || 3.0"
    },
    "suggest": {
        "ext-igbinary": "Faster and more compact serialization (serializer: igbinary)",
        "ext-msgpack": "MessagePack serialization (serializer: msgpack)"
    },
    "autoload": {
        "psr-4": {
            "Mfonte\\Redisw\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mfonte\\Redisw\\Test\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --colors=always",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "fix": "@php vendor/bin/php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite (requires a running Redis server)",
        "analyse": "Run PHPStan static analysis",
        "cs": "Check coding style without modifying files",
        "fix": "Fix coding style",
        "check": "Run coding style check, static analysis and tests"
    }
}
